# Copy to .env at the repository root. Never commit real values.
# Coretta uses PostgreSQL through Supabase. Copy the exact connection strings
# from Supabase Dashboard -> Connect -> ORMs -> Prisma.
# Use the Supavisor transaction pooler for a serverless runtime such as Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Use the direct connection when IPv6 is available, or the session pooler on
# port 5432 when the direct hostname is unavailable from your environment.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

PORT=3001
# SESSION_SECRET or JWT_SECRET (either accepted)
SESSION_SECRET=change-me-in-production
# JWT_SECRET=
WALLET_ENCRYPTION_KEY=change-me-32-char-minimum-secret!!
# Separate key used to encrypt Damian conversation and memory content.
AI_MEMORY_KEY=change-me-32-char-minimum-secret!!
# Comma-separated production origins, e.g. https://app.coretta.xyz
CORS_ORIGIN=http://localhost:3000
DEV_MODE=true

# Arc RPC (RPC_URL alias also accepted)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# RPC_URL=

# Bundler (Pimlico recommended)
# BUNDLER_RPC_URL=https://api.pimlico.io/v2/5042002/rpc?apikey=YOUR_KEY

# Circle (server-side only)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# KIT_KEY=   # Console → Keys → Kit Key (App Kit / Swap Kit)

# Privy email authentication
# Browser-safe App ID from Privy Dashboard → App settings → Basics
# PRIVY_APP_ID=
# Server-only App Secret from the same page
# PRIVY_APP_SECRET=
# Optional: full SPKI public key from "Verify with key instead". Omit it to let Privy fetch the app JWKS.
# PRIVY_JWT_VERIFICATION_KEY=

# Optional legacy Coretta OTP delivery. Privy email login does not use these.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS="Coretta Verification <verified@your-domain.example>"

# Optional limit overrides. Application defaults are used when omitted.
# SPONSORED_TX_LIMIT_DAILY=
# SPONSORED_USD_LIMIT_DAILY=
# AI_REQUEST_LIMIT_DAILY=
# OTP_LIMIT_HOURLY=

# Landing (apps/landing/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_WC_PROJECT_ID=
# NEXT_PUBLIC_PRIVY_APP_ID=   # same value as PRIVY_APP_ID; public by design

# Optional server-side Damian conversation model. Keep this key on the API only.
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
