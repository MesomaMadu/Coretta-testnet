# Copy to .env (repo root) and apps/api/.env — never commit real values.
# Prisma resolves SQLite paths relative to packages/db/prisma (schema dir).
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — change packages/db/prisma/schema.prisma provider to "postgresql"
# then set:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/coretta?schema=public"

PORT=3001
# SESSION_SECRET or JWT_SECRET (either accepted)
SESSION_SECRET=change-me-in-production
# JWT_SECRET=
WALLET_ENCRYPTION_KEY=change-me-32-char-minimum-secret!!
# Comma-separated production origins, e.g. https://app.coretta.xyz
CORS_ORIGIN=http://localhost:3000
DEV_MODE=true

# Arc RPC (RPC_URL alias also accepted)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# RPC_URL=

# Bundler (Pimlico recommended)
# BUNDLER_RPC_URL=https://api.pimlico.io/v2/5042002/rpc?apikey=YOUR_KEY

# Circle (server-side only)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# KIT_KEY=   # Console → Keys → Kit Key (App Kit / Swap Kit)

# Landing (apps/landing/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WC_PROJECT_ID=

# Email auth is TEMPORARILY DISABLED — do not rely on Resend for production login.

XAI_API_KEY=
