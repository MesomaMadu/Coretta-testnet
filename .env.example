# Copy to .env in repo root and apps/api

# Prisma resolves SQLite paths relative to packages/db/prisma (schema dir)
DATABASE_URL="file:./dev.db"
PORT=3001
SESSION_SECRET=change-me-in-production
WALLET_ENCRYPTION_KEY=change-me-32-char-minimum-secret!!
CORS_ORIGIN=http://localhost:5173
DEV_MODE=true

ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Optional: Pimlico API key URL for production
# BUNDLER_RPC_URL=https://api.pimlico.io/v2/5042002/rpc?apikey=YOUR_KEY

# Email OTP (Resend API)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=Coretta Verification <onboarding@resend.dev>
# Note: Resend onboarding sender only delivers to your Resend account email
# until a custom domain is verified.

# Circle (server-side — do not commit real values)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# Manual configuration required.

# Circle App Kit / Swap Kit (server-side only — for on-chain USDC↔EURC swaps)
# Create at https://console.circle.com → Keys → Kit Key
# KIT_KEY=
# Manual configuration required before implementing /v1/swap.

# Landing app
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WC_PROJECT_ID=
